# nightprint-importer — on the VPS in ~/apps/nightprint-importer/.env, chmod 600, never in git.

# Required: the key the importer asks the model with.
ANTHROPIC_API_KEY=

# Recommended: raises GitHub's API limit from 60 to 5,000 requests an hour.
# A fine-grained token with no permissions reads public repositories.
GITHUB_TOKEN=

# Dollars the model may cost in a UTC day, all visitors together. A drawing costs about 0.03.
DAILY_BUDGET_USD=1

# New drawings each visitor may start in a day. Cached drawings are free and unlimited.
DRAWINGS_PER_VISITOR=5
